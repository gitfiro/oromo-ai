training/packed/**/*.jsonl

# Keep initialization metadata/configs visible to Git;
# only large model weights are ignored above.

# Duplicate tokenizer copy inside initialized model directory.
# Canonical frozen tokenizer is tracked under tokenizer/augmentation/artifacts/.
models/initialization/*/tokenizer.json

# Preserved local experiment exports / extracted checkpoints
preserved/

# Local artifact checksum sidecars
*.sha256

# Generated +4K tokenizer artifact
/tokenizer/augmentation/artifacts/gemma-3-1b-pt-oromo-4k/tokenizer.json

