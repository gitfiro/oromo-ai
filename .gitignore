*.egg-info/

# Python caches
__pycache__/
*.py[cod]

# Local corpus data
data/raw/
data/processed/
data/manifests/
data/instruction/
data/parallel/
data/evaluation/

# Tokenizer generated data
tokenizer/training/*.txt
tokenizer/evaluation/samples/*.jsonl

# Trained tokenizer binary artifacts
tokenizer/training/candidates/**/*.model
tokenizer/training/candidates/**/*.vocab

# Intermediate generated corpus artifacts
data/interim/

# External language-identification models
models/language_id/glotlid/

# Large model and training artifacts
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.tar.gz

# Local trained model outputs / checkpoints
training/runs/
training/checkpoints/
models/initialization/*/model*.safetensors

# Hugging Face / experiment caches
.cache/
wandb/

# Local CPT datasets and packed training artifacts

# Local initialized/trained model directories

# Local CPT corpus text and packed token data
training/data/**/*.jsonl
training/packed/**/*.jsonl

# Keep initialization metadata/configs visible to Git;
# only large model weights are ignored above.

# Duplicate tokenizer copy inside initialized model directory.
# Canonical frozen tokenizer is tracked under tokenizer/augmentation/artifacts/.
models/initialization/*/tokenizer.json
